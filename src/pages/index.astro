---
import Base from '../layouts/Base.astro';
import { site } from '../site.mjs';
import { postsByYear, monthDay, isCJK } from '../lib/posts.mjs';

const years = postsByYear();
---

<Base current="posts">
  {
    site.quote.text && (
      <blockquote class="home-quote">
        <p>{site.quote.text}</p>
        {site.quote.source && <cite>— {site.quote.source}</cite>}
      </blockquote>
    )
  }
  {years.length === 0 && <p class="empty">还没有文章。</p>}
  {
    years.map(({ year, posts }) => (
      <section class="post-group">
        <h2 class="year">{year}</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={post.url} class={isCJK(post.title) ? undefined : 'latin'} lang={post.lang}>
                {post.title}
              </a>
              <span class="when">
                {monthDay(post.date)} · {post.category}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
